                    "parameters": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "intent"
                      ],
                      "properties": {
                        "intent": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1200
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "operation_id",
                    "kind",
                    "shot_id",
                    "output_start_sec",
                    "output_end_sec",
                    "evidence_refs",
                    "rationale",
                    "capability_status",
                    "parameters"
                  ],
                  "properties": {
                    "operation_id": {
                      "$ref": "#/$defs/operation_fields/operation_id"
                    },
                    "kind": {
                      "const": "custom"
                    },
                    "shot_id": {
                      "$ref": "#/$defs/operation_fields/shot_id"
                    },
                    "output_start_sec": {
                      "$ref": "#/$defs/operation_fields/output_start_sec"
                    },
                    "output_end_sec": {
                      "$ref": "#/$defs/operation_fields/output_end_sec"
                    },
                    "evidence_refs": {
                      "$ref": "#/$defs/operation_fields/evidence_refs"
                    },
                    "rationale": {
                      "$ref": "#/$defs/operation_fields/rationale"
                    },
                    "capability_status": {
                      "$ref": "#/$defs/operation_fields/capability_status"
                    },
                    "parameters": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "implementation_requirements"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1200
                        },
                        "implementation_requirements": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1200
                        }
                      }
                    }
                  }
                }
              ]
            }
          },
          "audio_strategy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intent",
              "sync_basis",
              "evidence_refs"
            ],
            "properties": {
              "intent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "sync_basis": {
                "enum": [
                  "none",
                  "onset_candidate",
                  "estimated_rhythm",
                  "verified_beat_grid"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 0,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1200
                }
              }
            }
          },
          "ending": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intent",
              "cta"
            ],
            "properties": {
              "intent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "cta": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text",
                      "kind",
                      "verification_status",
                      "evidence_refs",
                      "publish_ready"
                    ],
                    "properties": {
                      "text": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 300
                      },
                      "kind": {
                        "enum": [
                          "creative_copy",
                          "canonical_unverified",
                          "asr_draft",
                          "verified_quote",
                          "placeholder",
                          "external_claim"
                        ]
                      },
                      "verification_status": {
                        "enum": [
                          "unverified",
                          "verified"
                        ]
                      },
                      "evidence_refs": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 12,
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1200
                        },
                        "uniqueItems": true
                      },
                      "publish_ready": {
                        "const": false
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "required_reviews": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            }
          }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "uniqueItems": true
    },
    "required_reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      }
    },
    "factual_claims": {
      "type": "array",
      "minItems": 0,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "kind",
          "verification_status",
          "evidence_refs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "kind": {
            "enum": [
              "source_metadata",
              "source_quote",
              "vehicle_or_business_claim"
            ]
          },
          "verification_status": {
            "enum": [
              "unverified",
              "verified"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "uniqueItems": true
          }
        }
      }
    },
    "renderer_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_status",
        "supported_operations"
      ],
      "properties": {
        "verification_status": {
          "const": "unknown"
        },
        "supported_operations": {
          "const": []
        }
      }
    },
    "render_readiness": {
      "const": "BLOCKED_FOR_RENDER"
    },
    "publish_ready": {
      "const": false
    },
    "render_approved": {
      "const": false
    },
    "publish_approved": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mandala Adaptive Editing Plan V0.3",
  "$defs": {
    "operation_fields": {
      "operation_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "shot_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 60
      },
      "output_start_sec": {
        "type": "number",
        "minimum": 0,
        "description": "ABSOLUTE final output timeline seconds, NOT shot-local and NOT source time. Must be inside the named shot output window. Later shots start after preceding playback durations minus overlaps."
      },
      "output_end_sec": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "ABSOLUTE final output timeline seconds, NOT shot-local and NOT source time. Must be inside the named shot output window. Later shots start after preceding playback durations minus overlaps."
      },
      "evidence_refs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "uniqueItems": true
      },
      "rationale": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1200
      },
      "capability_status": {
        "enum": [
          "unknown",
          "requires_implementation",
          "blocked_missing_evidence",
          "supported"
        ]
      }
    }
  }
}
