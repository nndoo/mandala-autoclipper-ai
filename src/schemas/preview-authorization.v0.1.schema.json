{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single local Showcase preview authorization V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "authorization_mode",
    "source_sha256",
    "source_path",
    "plan_sha256",
    "execution_spec_sha256",
    "evidence_packet_sha256",
    "capabilities",
    "code_receipts",
    "original_blocked_plan",
    "original_blocked_report",
    "output_directory",
    "maximum_final_candidates",
    "local_preview_authorized",
    "production_approval_granted",
    "publish_approved",
    "labels",
    "prior_failure"
