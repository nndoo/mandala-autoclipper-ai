# Default deny: build from repository root, with only runtime/build source.
**
!.dockerignore
!.python-version
!requirements-av.txt
!requirements-av.lock.txt
!backend/
!backend/**
!scripts/
!scripts/**
!src/
!src/schemas/
!src/schemas/**
!config/
!config/**
!openclaw/
!openclaw/agents/
!openclaw/agents/**
!openclaw/prompts/
!openclaw/prompts/**
!openclaw/plugins/
!openclaw/plugins/mandala-9router-video/
!openclaw/plugins/mandala-9router-video/**

# Exclusions win over the allowlist above. Plugin tests are needed by npm test.
**/node_modules
**/dist
**/__pycache__
**/.ruff_cache
**/.pytest_cache
**/.mypy_cache
**/.git
**/.openclaw
**/.ssh
**/private
**/runtime-private
**/.env
**/.env.*
**/openclaw.json
**/auth-profiles.json
**/credentials.json
**/secrets.json
**/secrets.yaml
**/secrets.yml
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa
**/id_ed25519
**/*.log
**/*.py[cod]
**/*.tmp
**/*.swp
**/*~
**/*.bak
**/*.before-*
**/*.mp4
**/*.mov
**/*.mkv
**/*.webm
**/*.avi
**/*.wav
**/*.mp3
**/*.m4a
**/*.flac
**/*.sqlite
**/*.sqlite3
**/*.db
backend/vps_snapshot
# Always regenerate deployment binding and dist inside the plugin builder.
openclaw/plugins/mandala-9router-video/src/provider-id.generated.ts
openclaw/plugins/mandala-9router-video/openclaw.plugin.json
