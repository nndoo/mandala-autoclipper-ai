# Proposed editing service only; not the environment of the permanent Media Worker.
# Set this explicitly after verifying its name on the SAME Docker host.
MANDALA_ORIGINAL_VOLUME=muxr6rvojjjdrjrp24yjimak_autoclipper-data
MANDALA_EDITING_OUTPUT_VOLUME=mandala-ai-editing-output
# Existing Docker network shared with PostgreSQL; never exposes host ports.
MANDALA_DATABASE_NETWORK=coolify
# Non-secret provider ID; build argument and runtime manifest must match.
MANDALA_OPENCLAW_PROVIDER_ID=custom-ipt02mbjindt5ldise8woehy-43-129-33-7-sslip-io
# Stage 6.3.5 DB URLs, tokens, and proof path are supplied privately at runtime.
# The default image CMD keeps role dispatch disabled. Live role execution needs
# explicit MANDALA_EDITING_LIVE_ROLES_ENABLED=1 and separate operator approval;
# local TEST_ONLY replay is injected by tests, never selected from this file.
