{
  "name": "mandala-9router-video",
  "version": "0.1.0",
  "description": "Mandala Auto video understanding compatibility plugin for 9Router and OpenClaw",
  "private": true,
  "type": "module",
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {"pluginApi": ">=2026.9.9", "minGatewayVersion": "2026.9.9"},
    "build": {"openclawVersion": "2026.9.9", "pluginSdkVersion": "2026.9.9"}
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
